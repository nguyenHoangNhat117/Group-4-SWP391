<c:if test="${firstPayment}">
    <div class="mb-4">
        <label for="payment-percent" class="form-label fw-semibold">Tỷ lệ thanh toán ban đầu</label>
        <select id="payment-percent" name="payment-percent" class="form-select form-select-lg"
                required ${selectedPercent != null ? 'disabled' : ''}>
            <option value="10" ${selectedPercent == 10 || (selectedPercent == null && param['payment-percent'] == '10') ? 'selected' : ''}>10%</option>
            <option value="20" ${selectedPercent == 20 || (selectedPercent == null && param['payment-percent'] == '20') ? 'selected' : ''}>20%</option>
            <option value="100" ${selectedPercent == 100 || (selectedPercent == null && param['payment-percent'] == '100') ? 'selected' : ''}>100%</option>
        </select>
        <c:if test="${selectedPercent != null}">
            <input type="hidden" name="payment-percent" value="${selectedPercent}">
        </c:if>
        <div class="form-text">${selectedPercent != null ? 'Tỷ lệ thanh toán đã được chọn khi đặt phòng.' : 'Đây là lần thanh toán đầu tiên của đơn đặt phòng.'}</div>
    </div>
</c:if>

<c:if test="${!firstPayment}">
    <div class="alert alert-info">
        Giao dịch này sẽ thanh toán toàn bộ số tiền còn lại là <strong>${remainingAmount} VND</strong>.
    </div>
</c:if>

<div class="mb-4">
    <label for="payment-method" class="form-label fw-semibold">Phương thức thanh toán</label>
    <select id="payment-method" name="payment-method" class="form-select form-select-lg" required>
        <option value="">-- Chọn phương thức thanh toán --</option>
        <option value="cash" ${param['payment-method'] == 'cash' ? 'selected' : ''}>Tiền mặt</option>
        <option value="bank_transfer" ${param['payment-method'] == 'bank_transfer' ? 'selected' : ''}>Chuyển khoản (payOS)</option>
    </select>
</div>

<c:if test="${firstPayment}">
    <div class="mb-4">
        <label for="discount-code" class="form-label fw-semibold">Mã khuyến mãi <span class="text-muted">(không bắt buộc)</span></label>
        <input type="text" id="discount-code" name="discount-code" class="form-control form-control-lg"
               maxlength="50" placeholder="Nhập mã khuyến mãi" value="<c:out value='${param["discount-code"]}'/>">
    </div>

    <c:if test="${not empty promotions}">
        <div class="border rounded-3 p-3 mb-4">
            <h6 class="fw-bold mb-3">Khuyến mãi có thể áp dụng</h6>
            <c:forEach var="promotion" items="${promotions}">
                <div class="mb-2">
                    <strong><c:out value="${promotion.code}"/></strong> - ${promotion.saleOff}% giảm giá
                    <c:if test="${promotion.minimumAmount != null}"> | Tối thiểu: ${promotion.minimumAmount} VND</c:if>
                    <c:if test="${promotion.maximumDiscount != null}"> | Giảm tối đa: ${promotion.maximumDiscount} VND</c:if>
                </div>
            </c:forEach>
        </div>
    </c:if>
</c:if>

<div class="alert alert-info">
    Hệ thống sẽ tính số tiền cần thanh toán.
    Mã khuyến mãi chỉ áp dụng cho lần thanh toán đầu tiên.
</div>
